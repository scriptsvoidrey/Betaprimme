local function getClosestPlayerToCenter()
    local target = nil
    local shortestDistance = math.huge
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local humanoid = p.Character:FindFirstChildOfClass("Humanoid")
            local head = p.Character:FindFirstChild("Head")
            
            if humanoid and humanoid.Health > 0 and head then
                local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
                if onScreen then
                    local distance = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                    if distance < shortestDistance then
                        shortestDistance = distance
                        target = head
                    end
                end
            end
        end
    end
    return target
end

RunService.Heartbeat:Connect(function()
    if _G.AnkleBreakID ~= currentScriptID then return end

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local holdingTool = char and char:FindFirstChildOfClass("Tool")

    if hum and SpeedToggle then hum.WalkSpeed = CustomSpeed end

    if FovToggle then
        Camera.FieldOfView = CustomFov
    end

    if AimAssistToggle and holdingTool then
        local targetHead = getClosestPlayerToCenter()
        if targetHead then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetHead.Position)
        end
    end

    for _, p in ipairs(Players:GetPlayers()) do  
        if p ~= LocalPlayer and p.Character then
            local enemyChar = p.Character
            local enemyHRP = enemyChar:FindFirstChild("HumanoidRootPart")
            local enemyHum = enemyChar:FindFirstChildOfClass("Humanoid")
            local highlight = enemyChar:FindFirstChild("AnkleBreakHighlight")
            local visualPart = enemyChar:FindFirstChild("AnkleBreakVisual")
            
            if HitboxToggle and holdingTool and enemyHRP and enemyHum and enemyHum.Health > 0 then
                enemyHRP.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
                enemyHRP.CanTouch = true
                
                local alturaVisual = (hitboxSize / 2) - 3
                
                if not visualPart then
                    pcall(function()
                        visualPart = Instance.new("Part")
                        visualPart.Name = "AnkleBreakVisual"
                        visualPart.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
                        visualPart.Transparency = 0.85 
                        visualPart.Color = customHitboxColor
                        visualPart.Material = Enum.Material.SmoothPlastic
                        visualPart.CanCollide = false 
                        visualPart.CanTouch = true 
                        visualPart.Massless = true
                        visualPart.Parent = enemyChar
                        
                        local weld = Instance.new("Weld")
                        weld.Part0 = enemyHRP
                        weld.Part1 = visualPart
                        weld.C0 = CFrame.new(0, alturaVisual, 0)
                        weld.Parent = visualPart
                    end)
                else
                    pcall(function()
                        visualPart.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
                        visualPart.Color = customHitboxColor
                        local weld = visualPart:FindFirstChildOfClass("Weld")
                        if weld then
                            weld.C0 = CFrame.new(0, alturaVisual, 0)
                        end
                    end)
                end
                
                if not highlight then
                    highlight = Instance.new("Highlight")
                    highlight.Name = "AnkleBreakHighlight"
                    highlight.Adornee = enemyChar
                    highlight.Parent = enemyChar
                end
                
                highlight.FillColor = customHitboxColor
                highlight.OutlineColor = Color3.fromRGB(240, 240, 240)
                highlight.FillTransparency = 0.85
                highlight.OutlineTransparency = 0.4
            else
                if enemyHRP then
                    enemyHRP.Size = Vector3.new(2, 2, 1)
                end
                
                if visualPart then
                    visualPart:Destroy()
                end
                if highlight then 
                    highlight:Destroy() 
                end
            end
        end
    end

    local isShiftLocked = (Camera.CameraType == Enum.CameraType.Scriptable) or UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter
    if AutoLockToggle and holdingTool and hrp and not isShiftLocked then
        local closestHRP = nil
        local shortestDist = math.huge
        
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local enemyHRP = p.Character:FindFirstChild("HumanoidRootPart")
                local enemyHum = p.Character:FindFirstChildOfClass("Humanoid")
                if enemyHRP and enemyHum and enemyHum.Health > 0 then
                    local dist = (enemyHRP.Position - hrp.Position).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        closestHRP = enemyHRP
                    end
                end
            end
        end
        
        if closestHRP then
            local targetVelocity = closestHRP.Velocity
            local predictionFactor = 0.12 
            local predictedPos = closestHRP.Position + (targetVelocity * predictionFactor)
            
            local targetPos = Vector3.new(predictedPos.X, hrp.Position.Y, predictedPos.Z)
            local targetCFrame = CFrame.new(hrp.Position, targetPos)
            hrp.CFrame = hrp.CFrame:Lerp(targetCFrame, rotationSpeed)
        end
    end
end)

