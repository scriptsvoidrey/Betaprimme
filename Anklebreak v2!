local configFileName = "AnkleBreakConfig_Rayfield.json"

local function guardarConfig()
    pcall(function()
        local datos = {
            HitboxSize = hitboxSize,
            RotationSpeed = rotationSpeed,
            HitboxToggle = HitboxToggle,
            AutoLockToggle = AutoLockToggle,
            AimAssistToggle = AimAssistToggle,
            InfiniteJump = InfiniteJump,
            SpeedToggle = SpeedToggle,
            CustomSpeed = CustomSpeed,
            FovToggle = FovToggle,
            CustomFov = CustomFov,
            HitboxColorR = customHitboxColor.R,
            HitboxColorG = customHitboxColor.G,
            HitboxColorB = customHitboxColor.B
        }
        if writefile then
            writefile(configFileName, HttpService:JSONEncode(datos))
        end
    end)
end

local function cargarConfig()
    pcall(function()
        if readfile and isfile and isfile(configFileName) then
            local contenido = readfile(configFileName)
            local datos = HttpService:JSONDecode(contenido)
            if datos then
                hitboxSize = datos.HitboxSize or hitboxSize
                rotationSpeed = datos.RotationSpeed or rotationSpeed
                HitboxToggle = datos.HitboxToggle or HitboxToggle
                AutoLockToggle = datos.AutoLockToggle or AutoLockToggle
                AimAssistToggle = datos.AimAssistToggle or AimAssistToggle
                InfiniteJump = datos.InfiniteJump or InfiniteJump
                SpeedToggle = datos.SpeedToggle or SpeedToggle
                CustomSpeed = datos.CustomSpeed or CustomSpeed
                FovToggle = datos.FovToggle or FovToggle
                CustomFov = datos.CustomFov or CustomFov
                if datos.HitboxColorR and datos.HitboxColorG and datos.HitboxColorB then
                    customHitboxColor = Color3.new(datos.HitboxColorR, datos.HitboxColorG, datos.HitboxColorB)
                end
            end
        end
    end)
end

